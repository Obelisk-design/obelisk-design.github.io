---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PageCounter from '../components/PageCounter.astro';
import Giscus from '../components/Giscus.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { calculateReadingTime } from '../utils/readingTime';
import CopyCode from '../components/CopyCode.astro';
import ShareButtons from '../components/ShareButtons.astro';
import LikeButton from '../components/LikeButton.astro';
import FavoriteButton from '../components/FavoriteButton.astro';
import TOC from '../components/TOC.astro';
import RelatedPosts from '../components/RelatedPosts.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;

// Extract post id from the current URL path (e.g. /blog/mcp-protocol-deep-dive/ → mcp-protocol-deep-dive)
const id = Astro.url.pathname.split('/').filter(Boolean).pop()!;

const keywords = tags ? `${tags.join(', ')}, 技术博客, 深度解析` : '技术博客, 深度解析';

// Render slot ONCE, then reuse the HTML for both reading time and heading extraction
const body = await Astro.slots.render('default');
const readingTime = calculateReadingTime(body);

// Extract h2/h3 headings from rendered body
const headingRegex = /<h([2-3])[^>]*id="([^"]+)"[^>]*>(.*?)<\/h\1>/g;
const headings: { depth: number; text: string; slug: string }[] = [];
let match;
while ((match = headingRegex.exec(body)) !== null) {
  // Strip any inline HTML tags (e.g. <code>, <a>) from heading text
  const text = match[3].replace(/<[^>]*>/g, '').trim();
  if (text) {
    headings.push({
      depth: parseInt(match[1]),
      slug: match[2],
      text,
    });
  }
}
---

<html lang="zh-CN">
  <head>
    <BaseHead 
      title={title} 
      description={description} 
      image={heroImage}
      keywords={keywords}
      article={{
        publishedTime: pubDate,
        modifiedTime: updatedDate,
        author: "Obelisk Design",
        tags: tags
      }}
    />
    <style>
      main {
        max-width: 1200px;  /* Wider to accommodate TOC */
      }

      .article-container {
        display: grid;
        grid-template-columns: 1fr 220px;
        gap: 2rem;
        align-items: start;
      }

      .article-content {
        min-width: 0;
      }

      .hero-image {
        width: 100%;
        margin-bottom: 2rem;
      }

      .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        border: 1px solid var(--border);
      }

      .article-header {
        margin-bottom: 3rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--border);
      }

      .article-meta {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
        color: var(--text-muted);
      }

      .article-tags {
        display: flex;
        gap: 0.5rem;
      }

      .article-tag {
        padding: 0.25rem 0.75rem;
        background: var(--bg-card);
        border-radius: 4px;
        color: var(--accent);
        font-size: 0.85rem;
        font-family: var(--font-mono);
      }

      .article-title {
        font-size: 2.5rem;
        line-height: 1.2;
        margin-bottom: 1rem;
      }

      .article-description {
        font-size: 1.1rem;
        color: var(--text-secondary);
        margin-bottom: 0;
      }

      .prose {
        width: 100%;
      }

      .last-updated {
        font-style: italic;
        color: var(--text-muted);
        margin-left: 1rem;
      }

      /* Article typography tweaks */
      .prose h2 {
        margin-top: 3rem;
      }

      .prose h3 {
        margin-top: 2rem;
      }

      .prose h4 {
        margin-top: 1.5rem;
        color: var(--text-primary);
      }

      @media (max-width: 768px) {
        main {
          padding: 1rem;
        }
        
        .article-header {
          margin-bottom: 2rem;
          padding-bottom: 1.5rem;
        }
        
        .article-title {
          font-size: 1.75rem;
        }

        .article-meta {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.5rem;
        }
        
        .article-description {
          font-size: 1rem;
        }
        
        .hero-image {
          margin-left: -1rem;
          margin-right: -1rem;
          width: calc(100% + 2rem);
          margin-bottom: 1.5rem;
        }
        
        .hero-image img {
          border-radius: 0;
        }
      }
      
      @media (max-width: 480px) {
        .article-title {
          font-size: 1.5rem;
        }
        
        .article-tag {
          font-size: 0.75rem;
          padding: 0.2rem 0.5rem;
        }
        
        .prose h2 {
          font-size: 1.35rem;
          margin-top: 2rem;
        }
        
        .prose h3 {
          font-size: 1.15rem;
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <ReadingProgress />
    <main>
      <div class="article-container">
        <div class="article-content">
          <article>
            {heroImage && (
              <div class="hero-image">
                <Image width={900} height={450} src={heroImage} alt="" />
              </div>
            )}

            <header class="article-header">
          <div class="article-meta">
            <FormattedDate date={pubDate} />
            <span class="reading-time">{readingTime}</span>
            {updatedDate && (
              <span class="last-updated">
                更新于 <FormattedDate date={updatedDate} />
              </span>
            )}
            <PageCounter />
            {tags && tags.length > 0 && (
              <div class="article-tags">
                {tags.map((tag) => (
                  <span class="article-tag">{tag}</span>
                ))}
              </div>
            )}
          </div>
          <h1 class="article-title">{title}</h1>
          <p class="article-description">{description}</p>
        </header>
        
        <div class="prose">
          {body}
        </div>

        <CopyCode />

        <div class="article-actions">
          <LikeButton postId={id} />
          <FavoriteButton postId={id} title={title} />
        </div>

        <ShareButtons title={title} url={Astro.url.href} />

        <RelatedPosts currentPostId={id} currentTags={tags} />

        <Giscus />
          </article>
        </div>

        {headings.length > 0 && (
          <TOC headings={headings} />
        )}
      </div>
    </main>
    <Footer />
  </body>
</html>