---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`关于 - ${SITE_TITLE}`} description="关于 Obelisk Design 博客" />
  </head>
  <body>
    <Header />
    <main>
      <section class="about-hero">
        <h1>关于</h1>
        <p class="hero-subtitle">第一性原理驱动的技术写作实验室</p>
      </section>

      <section class="about-content">
        <h2>为什么存在</h2>
        <p>
          大多数技术内容告诉你「怎么做」，却从不解释「为什么这样做有效」。
          这让知识成为不可迁移的碎片——你会用某个方案，但无法推导它，也无法在新场景变异它。
        </p>
        <p>
          Obelisk Design 打破这个模式。我们不继承「最佳实践」，而是追溯源头，
          理解技术选择的历史语境，揭示真正运作的机制。
        </p>

        <h2>核心理念</h2>
        <div class="principles">
          <div class="principle">
            <h3>从原理出发</h3>
            <p>
              每一个结论都必须能被推导。如果我无法从基本假设推导一个观点，
              我就不应该断言它——无论多少人认同它。
            </p>
          </div>
          <div class="principle">
            <h3>机制高于摘要</h3>
            <p>
              表面总结掩盖了真正运作的系统。我们深入一层，
              理解「如何工作」，而不只是知道「是什么」。
            </p>
          </div>
          <div class="principle">
            <h3>追溯历史语境</h3>
            <p>
              每个技术选择都有被发明的原因。理解那个原因，
              才能判断它今天是否仍然适用。
            </p>
          </div>
        </div>

        <h2>内容风格</h2>
        <p>
          文章遵循「从浅到深」的渐进结构：入门者理解基础概念，
          专业者获得深层洞察。不为简洁牺牲精确，也不为完整牺牲可读性。
        </p>

        <h2>技术栈</h2>
        <p>
          本站使用 Astro 构建，采用深色科技简约主题。
          内容在 GitHub 进行版本管理，使用 Hermes AI Agent 辅助写作。
        </p>
        <ul class="tech-list">
          <li><span class="tech-label">框架</span> Astro 6.x</li>
          <li><span class="tech-label">样式</span> 自定义 CSS</li>
          <li><span class="tech-label">字体</span> Inter + JetBrains Mono</li>
          <li><span class="tech-label">写作</span> Hermes AI Agent + Markdown</li>
        </ul>

        <h2>联系方式</h2>
        <p>
          有问题或建议？欢迎通过 GitHub 与我们交流：
        </p>
        <div class="contact-links">
          <a href="https://github.com/Obelisk-design" target="_blank" class="contact-link">
            <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
            </svg>
            GitHub: Obelisk-design
          </a>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .about-hero {
    padding: 4rem 0 2rem;
    text-align: center;
  }

  .about-hero h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    margin-bottom: 0;
  }

  .about-content {
    padding-bottom: 3rem;
  }

  .about-content h2 {
    margin-top: 3rem;
    padding-bottom: 0.75rem;
  }

  .about-content p {
    line-height: 1.8;
  }

  .about-content ul {
    list-style: none;
    padding: 0;
  }

  .tech-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.75rem;
  }

  .tech-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--bg-card);
    border-radius: 6px;
    color: var(--text-secondary);
  }

  .tech-label {
    color: var(--accent);
    font-weight: 500;
  }

  .principles {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .principle {
    padding: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .principle h3 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }

  .principle p {
    font-size: 0.95rem;
    margin-bottom: 0;
  }

  .contact-links {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-primary);
    transition: all 0.2s ease;
  }

  .contact-link:hover {
    border-color: var(--border-accent);
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .about-hero {
      padding: 3rem 0 1.5rem;
    }
    
    .about-hero h1 {
      font-size: 2.5rem;
    }
    
    .hero-subtitle {
      font-size: 1.1rem;
    }

    .principles {
      grid-template-columns: 1fr;
    }
    
    .about-content h2 {
      margin-top: 2.5rem;
    }
    
    .principle {
      padding: 1.25rem;
    }
  }
  
  @media (max-width: 480px) {
    .about-hero {
      padding: 2.5rem 0 1rem;
    }
    
    .about-hero h1 {
      font-size: 2rem;
    }
    
    .hero-subtitle {
      font-size: 1rem;
    }
    
    .about-content h2 {
      margin-top: 2rem;
      font-size: 1.35rem;
    }
    
    .principle {
      padding: 1rem;
    }
    
    .principle h3 {
      font-size: 1rem;
    }
    
    .principle p {
      font-size: 0.9rem;
    }
    
    .contact-link {
      padding: 0.6rem 1rem;
      font-size: 0.95rem;
    }
    
    .contact-link svg {
      width: 18px;
      height: 18px;
    }
  }
</style>