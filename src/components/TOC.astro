---
// Table of Contents - Auto-generated from headings
interface Props {
  headings: { depth: number; text: string; slug: string }[];
}

const { headings } = Astro.props;

// Filter h2 and h3 only
const tocItems = headings.filter(h => h.depth >= 2 && h.depth <= 3);
---

{tocItems.length > 0 && (
  <nav class="toc" aria-label="目录">
    <h4>目录</h4>
    <ul>
      {tocItems.map((item) => (
        <li class={`toc-item depth-${item.depth}`}>
          <a href={`#${item.slug}`}>{item.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc {
    position: sticky;
    top: 100px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    padding: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .toc h4 {
    margin: 0 0 1rem 0;
    font-size: 0.9rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin-bottom: 0.5rem;
  }

  .toc-item a {
    color: var(--text-secondary);
    font-size: 0.85rem;
    line-height: 1.4;
    transition: color 0.2s;
  }

  .toc-item a:hover {
    color: var(--accent);
  }

  .toc-item.depth-3 {
    padding-left: 1rem;
  }

  @media (max-width: 1024px) {
    .toc {
      display: none;
    }
  }
</style>

<script>
  // Highlight active section
  const tocLinks = document.querySelectorAll('.toc a');
  const sections = new Map();

  tocLinks.forEach(link => {
    const slug = link.getAttribute('href')?.substring(1);
    if (slug) {
      const section = document.getElementById(slug);
      if (section) {
        sections.set(section, link);
      }
    }
  });

  function updateActiveLink() {
    let activeSection = null;
    let minDistance = Infinity;

    sections.forEach((link, section) => {
      const rect = section.getBoundingClientRect();
      const distance = Math.abs(rect.top - 150);

      if (distance < minDistance && rect.top < 200) {
        minDistance = distance;
        activeSection = link;
      }
    });

    tocLinks.forEach(link => {
      link.style.color = '';
    });

    if (activeSection) {
      activeSection.style.color = 'var(--accent)';
    }
  }

  window.addEventListener('scroll', updateActiveLink, { passive: true });
  updateActiveLink();
</script>