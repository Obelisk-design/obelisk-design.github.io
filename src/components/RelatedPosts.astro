---
// Related Posts - Based on tags matching
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  currentPostId: string;
  currentTags?: string[];
}

const { currentPostId, currentTags = [] } = Astro.props;

// Get all blog posts
const allPosts = await getCollection('blog');

// Calculate relevance score
function calculateRelevance(post: CollectionEntry<'blog'>) {
  if (post.id === currentPostId) return 0; // Exclude current post

  const postTags = post.data.tags || [];
  const commonTags = postTags.filter(tag => currentTags.includes(tag));

  return commonTags.length;
}

// Sort by relevance and get top 3
const relatedPosts = allPosts
  .map(post => ({
    post,
    relevance: calculateRelevance(post)
  }))
  .filter(item => item.relevance > 0)
  .sort((a, b) => b.relevance - a.relevance)
  .slice(0, 3)
  .map(item => item.post);
---

{relatedPosts.length > 0 && (
  <section class="related-posts">
    <h2>相关文章推荐</h2>
    <div class="related-grid">
      {relatedPosts.map((post) => (
        <a href={`/blog/${post.id}/`} class="related-card">
          {post.data.heroImage && (
            <img src={post.data.heroImage} alt="" loading="lazy" />
          )}
          <div class="related-content">
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="related-meta">
              <time>{post.data.pubDate.toLocaleDateString('zh-CN')}</time>
              {post.data.tags && (
                <div class="related-tags">
                  {post.data.tags.filter(tag => currentTags.includes(tag)).map((tag) => (
                    <span class="tag-match">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-posts {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
  }

  .related-posts h2 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .related-card {
    display: block;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.2s;
    color: inherit;
  }

  .related-card:hover {
    border-color: var(--border-accent);
    transform: translateY(-2px);
  }

  .related-card img {
    width: 100%;
    height: 120px;
    object-fit: cover;
    border-radius: 0;
  }

  .related-content {
    padding: 1rem;
  }

  .related-content h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .related-content p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .related-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .related-tags {
    display: flex;
    gap: 0.5rem;
  }

  .tag-match {
    padding: 0.2rem 0.5rem;
    background: rgba(88, 166, 255, 0.1);
    border-radius: 3px;
    color: var(--accent);
    font-size: 0.75rem;
  }

  @media (max-width: 768px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>